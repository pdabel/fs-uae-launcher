{
  "description": "Golden cases for the netplay config hash: SHA-1 over the UTF-8 values of the listed keys, in list order, concatenated with no separator. launcher_config.checksum_config and fsnp-server's game.ConfigHash must both produce sha1 for every case. Every listed key must be in config.",
  "cases": [
    {
      "name": "empty",
      "note": "No keys hashes the empty string.",
      "keys": [],
      "config": {},
      "sha1": "da39a3ee5e6b4b0d3255bfef95601890afd80709"
    },
    {
      "name": "all-empty-values",
      "note": "Empty values add nothing: same as no keys.",
      "keys": [
        "amiga_model",
        "chip_memory"
      ],
      "config": {
        "amiga_model": "",
        "chip_memory": ""
      },
      "sha1": "da39a3ee5e6b4b0d3255bfef95601890afd80709"
    },
    {
      "name": "ordered",
      "note": "Values are hashed in key-list order.",
      "keys": [
        "amiga_model",
        "chip_memory"
      ],
      "config": {
        "amiga_model": "A500",
        "chip_memory": "512"
      },
      "sha1": "a698e9163576a9732a1e1249963a2c35e60f1285"
    },
    {
      "name": "ordered-reversed",
      "note": "Same config, keys reversed: a different hash.",
      "keys": [
        "chip_memory",
        "amiga_model"
      ],
      "config": {
        "amiga_model": "A500",
        "chip_memory": "512"
      },
      "sha1": "9ae413ed9b62aaeca4d94667f9e1fb504f412cd9"
    },
    {
      "name": "duplicate-key",
      "note": "A key listed twice is hashed twice; build_cfg lists floppy_drive_count, cdrom_drive_count and nes_model twice, so a server must not dedupe the key list.",
      "keys": [
        "floppy_drive_count",
        "amiga_model",
        "floppy_drive_count"
      ],
      "config": {
        "floppy_drive_count": "2",
        "amiga_model": "A500"
      },
      "sha1": "db97c4b05ecebecf06fe0f96af4b2102c1a7fe28"
    },
    {
      "name": "no-separator-1",
      "note": "Values are concatenated with no separator, so this and no-separator-2 collide. Pinned so neither side adds one alone.",
      "keys": [
        "a",
        "b"
      ],
      "config": {
        "a": "ab",
        "b": "c"
      },
      "sha1": "a9993e364706816aba3e25717850c26c9cd0d89d"
    },
    {
      "name": "no-separator-2",
      "note": "See no-separator-1.",
      "keys": [
        "a",
        "b"
      ],
      "config": {
        "a": "a",
        "b": "bc"
      },
      "sha1": "a9993e364706816aba3e25717850c26c9cd0d89d"
    },
    {
      "name": "extra-config-keys",
      "note": "Config keys not in the key list are ignored.",
